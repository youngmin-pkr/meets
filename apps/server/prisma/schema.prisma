// 1단계(가입·본인 확인)에 필요한 표만 만듭니다.
// 나머지 엔티티는 해당 단계에서 추가합니다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// 나이 구분. 본인 확인 결과로만 정해지고 사용자가 바꿀 수 없습니다.
/// (미인증·가입 불가는 계정이 만들어지기 전 상태라 저장하지 않습니다.)
enum AgeClass {
  ADULT
  TEEN
}

/// 이용 상태
enum AccountStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum NotificationChoice {
  ALLOWED
  DENIED
}

model User {
  id                    String              @id @default(uuid())
  nickname              String?
  /// 같은 별명 막기용 (영문은 소문자로 바꾼 값)
  nicknameKey           String?             @unique
  avatarInitial         String?
  avatarColor           String?
  ageClass              AgeClass
  status                AccountStatus       @default(ACTIVE)
  fandomPublic          Boolean             @default(false)
  trustLevel            Int                 @default(1)
  profileCompletedAt    DateTime?
  fandomStepCompletedAt DateTime?
  notificationChoice    NotificationChoice?
  signupCompletedAt     DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  identity IdentityVerification?
  consents TermsConsent[]
  fandoms  UserFandom[]
  sessions Session[]
  eventReports EventReport[]
  preferences  Preference[]
  waitRegistrations WaitRegistration[]
  ticketVerifications TicketVerification[]
  attendancePlans     AttendancePlan[]
  sentProposals       Proposal[] @relation("ProposalSender")
  receivedProposals   Proposal[] @relation("ProposalReceiver")
  appointmentParticipations AppointmentParticipant[]
}

/// 본인 확인 기록. 이름·전화번호는 저장하지 않고,
/// 같은 사람이 계정을 두 개 만들지 못하도록 CI의 해시만 둡니다.
/// 생년월일·성별은 매칭의 필수 조건(나이 범위·같은 성별)에만 쓰고 다른 사용자에게 보여 주지 않습니다.
model IdentityVerification {
  id         String   @id @default(uuid())
  userId     String   @unique
  ciHash     String   @unique
  provider   String
  /// "YYYY-MM-DD"
  birthDate  String?
  /// "M" | "F"
  gender     String?
  verifiedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model TermsConsent {
  id          String   @id @default(uuid())
  userId      String
  termCode    String
  termVersion String
  agreedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, termCode, termVersion])
}

model Fandom {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  users     UserFandom[]
}

model UserFandom {
  userId    String
  fandomId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  fandom    Fandom   @relation(fields: [fandomId], references: [id])

  @@id([userId, fandomId])
}

/// 로그인 유지. 토큰 원문은 저장하지 않고 해시만 둡니다.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

/// 정책 값. 같은 key가 여러 줄이면 적용 시작이 지난 것 중 가장 최근 값을 씁니다.
/// (값을 바꾸는 기능과 두 명 확인은 운영 콘솔 단계에서 만듭니다.)
model PolicyValue {
  id            String   @id @default(uuid())
  key           String
  value         Json
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([key, effectiveFrom])
}

/// 운영자의 모든 열람·변경 기록 (누가, 언제, 무엇을, 왜)
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

// ───────────── 2단계: 행사와 운영자 ─────────────

enum EventCategory {
  PERFORMANCE
  EXHIBITION
}

enum EventType {
  CONCERT
  FESTIVAL
  EXHIBITION
  POPUP
  EXPO
}

/// 행사 상태 (정리문서 5장 "행사")
enum EventStatus {
  REPORTED
  REVIEWING
  REGISTERED
  REJECTED
  CHANGED
  CANCELLED
}

/// 행사. 포스터·사진 없이 사실 정보만 저장합니다.
model Event {
  id             String        @id @default(uuid())
  name           String
  category       EventCategory
  /// 제보로 들어온 행사는 검수 때 정합니다.
  type           EventType?
  venue          String?
  officialUrl    String
  /// 같은 행사인지 비교하는 값 (같은 공식 링크면 하나로 합침)
  officialUrlKey String        @unique
  ticketRequired Boolean       @default(true)
  status         EventStatus
  statusReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  days          EventDay[]
  meetingSpots  MeetingSpot[]
  reports       EventReport[]
  preferences   Preference[]
  waitRegistrations WaitRegistration[]
  ticketVerifications TicketVerification[]
  attendancePlans     AttendancePlan[]

  proposals           Proposal[]
  appointments        Appointment[]

  @@index([status])
}

/// 행사의 하루. 하루짜리 행사도 1개가 있습니다. 시각은 한국 시간 "HH:MM"입니다.
model EventDay {
  id        String         @id @default(uuid())
  eventId   String
  date      String
  startTime String
  endTime   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  segments  EventSegment[]
  preferenceDays PreferenceDay[]
  proposals      Proposal[]
  appointments   Appointment[]

  @@unique([eventId, date])
}

/// 같이 볼 구간 후보
model EventSegment {
  id         String   @id @default(uuid())
  eventDayId String
  label      String
  startTime  String
  endTime    String
  sortOrder  Int      @default(0)
  eventDay   EventDay @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
}

/// 만날 장소. 운영팀이 정하고 사용자는 만들지 않습니다.
model MeetingSpot {
  id           String  @id @default(uuid())
  eventId      String
  name         String
  /// 공개된 장소인지. 공개된 장소만 사용자에게 보여 줍니다.
  isPublicPlace Boolean
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposals    Proposal[]
  appointments Appointment[]
}

/// 사용자 제보. 같은 행사(같은 공식 링크)의 제보는 하나의 Event에 합칩니다.
model EventReport {
  id          String        @id @default(uuid())
  reporterId  String
  eventId     String
  category    EventCategory
  name        String
  dateText    String?
  placeText   String?
  officialUrl String
  createdAt   DateTime      @default(now())
  /// 등록 안내 알림을 보낸 시각 (알림은 4단계에서 연결)
  notifiedAt  DateTime?
  reporter    User          @relation(fields: [reporterId], references: [id])
  event       Event         @relation(fields: [eventId], references: [id])

  @@unique([reporterId, eventId])
}

/// 운영자 역할 (정리문서 7장)
enum AdminRole {
  REVIEWER
  REPORT_MANAGER
  EVENT_MANAGER
  ADMIN
}

model AdminUser {
  id           String         @id @default(uuid())
  loginId      String         @unique
  /// 비밀번호 원문은 저장하지 않습니다.
  passwordHash String
  role         AdminRole
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id])
}

enum ApprovalKind {
  EVENT_CANCEL
  USER_SUSPEND
  POLICY_CHANGE
}

enum ApprovalStatus {
  PENDING
  CONFIRMED
}

/// 두 명 확인 작업. 제안자와 확정자는 달라야 합니다.
model AdminApproval {
  id            String         @id @default(uuid())
  kind          ApprovalKind
  targetId      String
  reason        String
  proposedById  String
  confirmedById String?
  status        ApprovalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  decidedAt     DateTime?

  @@index([kind, targetId, status])
}

// ───────────── 3단계: 입력 흐름과 매칭 ─────────────

/// 입력 흐름의 결과 (행사마다 하나). 매칭의 입력입니다.
model Preference {
  id               String          @id @default(uuid())
  userId           String
  eventId          String
  /// Q1~Q3 답 (1~3)
  tempoAnswers     Int[]
  /// 몰입도 질문 2개(행사 종류에 맞는 질문, 함께 즐길 때)의 답 (1~3)
  immersionAnswers Int[]
  tempoLevel       Int
  immersionLevel   Int
  mustGender       String
  mustAge          String
  promises         String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id])
  event            Event           @relation(fields: [eventId], references: [id])
  days             PreferenceDay[]

  @@unique([userId, eventId])
  @@index([eventId])
}

/// 고른 날의 일정: 도착 가능 시간, 귀가 마감, 같이할 구간
model PreferenceDay {
  id                 String     @id @default(uuid())
  preferenceId       String
  eventDayId         String
  arriveTime         String
  leaveTime          String
  togetherSegmentIds String[]
  preference         Preference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  eventDay           EventDay   @relation(fields: [eventDayId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, eventDayId])
}

/// 후보 없음 → 알림 신청. 출시 후 행사별 대기방으로 넓힐 수 있게 행사 단위로 저장합니다.
model WaitRegistration {
  id         String    @id @default(uuid())
  userId     String
  eventId    String
  /// 신청 당시 조건 (고른 날, 몰입도 한 단계 차이도 알려 줄지)
  conditions Json
  /// 이 날짜(포함)까지만 알림 ("YYYY-MM-DD", 행사 3일 전)
  endsOn     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// 마지막으로 알림을 보낸 시각 (알림은 4단계에서 연결)
  notifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [id])
  event      Event     @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

// ───────────── 6단계: 티켓 인증 ─────────────

enum TicketKind {
  TICKET
  RESERVATION
}

/// 티켓 인증 상태 (정리문서 5장 "티켓 인증")
enum TicketStatus {
  STARTED
  UPLOADED
  CONFIRMED
  REVIEW_PENDING
  VERIFIED
  FAILED
  REVERIFYING
}

/// 티켓 인증. 예매번호 원문과 원본 이미지는 저장하지 않습니다.
model TicketVerification {
  id               String        @id @default(uuid())
  userId           String
  eventId          String
  kind             TicketKind
  status           TicketStatus
  /// 예매번호 해시 (행사 + 번호). 원문은 저장하지 않음
  reservationHash  String?
  /// 티켓으로 입장할 수 있는 날 (EventDay id)
  admissibleDayIds String[]
  /// 사람이 검수하는 이유: DUPLICATE_SUSPECT | REPORTED | LOW_CONFIDENCE | RANDOM
  reviewReason     String?
  /// 실패 이유: UNREADABLE | WRONG_EVENT | DUPLICATE | OTHER
  failReason       String?
  /// 가린 이미지를 지운 시각
  imageDeletedAt   DateTime?
  reviewerId       String?
  heldAt           DateTime?
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])
  event            Event         @relation(fields: [eventId], references: [id])
  image            TicketImage?
  hashOwner        TicketHash?

  @@index([userId, eventId])
  @@index([status])
}

/// 가린 캡처 이미지. 확인이 끝나면 바로 지웁니다. (원본은 저장하지 않음)
model TicketImage {
  verificationId String             @id
  data           Bytes
  mimeType       String
  createdAt      DateTime           @default(now())
  verification   TicketVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

/// 예매번호 해시의 주인 (같은 예매번호는 여러 계정이 못 씀)
model TicketHash {
  hash           String             @id
  verificationId String             @unique
  verification   TicketVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

/// 티켓이 필요 없는 행사의 '참석 예정'
model AttendancePlan {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])

  @@id([userId, eventId])
}

// ───────────── 3-2단계: 제안과 약속 ─────────────

/// 제안 상태 (정리문서 5장 "제안")
enum ProposalStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

/// 제안 종류: 일반 / 즉석 / 청소년 그룹 (지금은 일반만)
enum ProposalKind {
  NORMAL
  INSTANT
  TEEN_GROUP
}

model Proposal {
  id            String         @id @default(uuid())
  kind          ProposalKind   @default(NORMAL)
  senderId      String
  receiverId    String
  eventId       String
  eventDayId    String
  /// 함께할 구간 (EventSegment id). 구간이 없는 날은 빈 목록
  segmentIds    String[]
  meetingSpotId String
  status        ProposalStatus
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sender        User           @relation("ProposalSender", fields: [senderId], references: [id])
  receiver      User           @relation("ProposalReceiver", fields: [receiverId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id])
  eventDay      EventDay       @relation(fields: [eventDayId], references: [id])
  meetingSpot   MeetingSpot    @relation(fields: [meetingSpotId], references: [id])
  appointment   Appointment?

  @@index([receiverId, status])
  @@index([senderId, status])
}

/// 약속 상태 (정리문서 5장 "약속"). 상태 바꾸기는 4단계에서 만듭니다.
enum AppointmentStatus {
  PENDING_CONFIRM
  CONFIRMED
  IN_PROGRESS
  ENDED
  ENDED_EARLY
  CANCELLED
  RESCHEDULING
  ON_HOLD
  AUTO_ENDED
}

/// 약속. 제안이 수락되면 '확정 대기'로 만들어집니다.
model Appointment {
  id            String                   @id @default(uuid())
  proposalId    String                   @unique
  eventId       String
  eventDayId    String
  segmentIds    String[]
  meetingSpotId String
  status        AppointmentStatus
  confirmedAt   DateTime?
  endReason     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  proposal      Proposal                 @relation(fields: [proposalId], references: [id])
  event         Event                    @relation(fields: [eventId], references: [id])
  eventDay      EventDay                 @relation(fields: [eventDayId], references: [id])
  meetingSpot   MeetingSpot              @relation(fields: [meetingSpotId], references: [id])
  participants  AppointmentParticipant[]
}

/// 약속에 참여하는 사람. 전날 확인·도착 기록·취소는 4단계에서 씁니다.
model AppointmentParticipant {
  appointmentId        String
  userId               String
  dayBeforeConfirmedAt DateTime?
  arrivedAt            DateTime?
  cancelledAt          DateTime?
  lateCancel           Boolean?
  appointment          Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user                 User        @relation(fields: [userId], references: [id])

  @@id([appointmentId, userId])
}
